<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Gongke.SolidWorks</AssemblyName>
    <RootNamespace>Gongke.SolidWorks</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.1.0</Version>
    <SolidWorksInteropDir Condition="'$(SolidWorksInteropDir)' == ''">$(SOLIDWORKS_INTEROP_DIR)</SolidWorksInteropDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <Reference Include="SolidWorks.Interop.sldworks"><HintPath>$(SolidWorksInteropDir)/SolidWorks.Interop.sldworks.dll</HintPath><Private>false</Private><EmbedInteropTypes>false</EmbedInteropTypes></Reference>
    <Reference Include="SolidWorks.Interop.swconst"><HintPath>$(SolidWorksInteropDir)/SolidWorks.Interop.swconst.dll</HintPath><Private>false</Private><EmbedInteropTypes>false</EmbedInteropTypes></Reference>
    <Reference Include="SolidWorks.Interop.swpublished"><HintPath>$(SolidWorksInteropDir)/SolidWorks.Interop.swpublished.dll</HintPath><Private>false</Private><EmbedInteropTypes>false</EmbedInteropTypes></Reference>
  </ItemGroup>
  <Target Name="RequireRealSolidWorksReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(SolidWorksInteropDir)/SolidWorks.Interop.sldworks.dll') Or !Exists('$(SolidWorksInteropDir)/SolidWorks.Interop.swconst.dll') Or !Exists('$(SolidWorksInteropDir)/SolidWorks.Interop.swpublished.dll')" Text="Set SolidWorksInteropDir to the official SOLIDWORKS api/redist directory. Native SDK references are required; no substitutes are generated." />
  </Target>
</Project>
