{
  "name": "gongke-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "构想引擎工程工作台",
  "author": "Gongke Workbench",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist-electron', {recursive:true, force:true})\" && tsc -p tsconfig.json && tsc -p tsconfig.electron.json && vite build && node -e \"require('node:fs').copyFileSync('src/assets/OFL.txt', 'dist/assets/OFL.txt')\"",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "package": "npm run build && electron-builder --dir",
    "test": "node --test tests/*.test.cjs",
    "package:windows": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.4.0",
    "@fluentui/react-components": "^9.75.1",
    "@fluentui/react-icons": "^2.0.345",
    "dxf-viewer": "^1.0.50",
    "pdfjs-dist": "5.4.296",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "org.gongke.workbench",
    "productName": "构想引擎",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "service",
        "to": "service"
      },
      {
        "from": "../adapters",
        "to": "adapters",
        "filter": [
          "**/*",
          "!**/obj/**",
          "!**/bin/**"
        ]
      },
      {
        "from": "../freecad",
        "to": "host-module/freecad",
        "filter": [
          "**/*",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "../gongke_core",
        "to": "host-module/gongke_core",
        "filter": [
          "**/*",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "../data",
        "to": "host-module/data",
        "filter": [
          "**/*",
          "!**/__pycache__/**"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "zip"
      ],
      "identity": "-",
      "sign": "./scripts/sign-development.cjs",
      "hardenedRuntime": false,
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "extraResources": [
        {
          "from": "native/embed/publish",
          "to": "embed",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "runtime/freecad",
          "to": "freecad"
        },
        {
          "from": "../out/autocad-ci",
          "to": "plugins/autocad"
        },
        {
          "from": "../LICENSE",
          "to": "licenses/gongke-LGPL-2.1.txt"
        }
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "icon": "assets/brand/logo-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "gongke-${version}-windows-x64-setup.${ext}",
      "perMachine": false,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
