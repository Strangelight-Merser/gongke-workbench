{
  "name": "gongke-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "构想引擎工程工作台",
  "author": "Gongke Workbench",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.electron.json && vite build",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "package": "npm run build && electron-builder --dir",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "org.gongke.workbench",
    "productName": "构想引擎",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "service",
        "to": "service"
      },
      {
        "from": "../adapters",
        "to": "adapters",
        "filter": [
          "**/*",
          "!**/obj/**",
          "!**/bin/**"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "zip"
      ],
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
